import { PASSIVES, type PassiveId } from "../data/passives";
import { SPELLS, TRIGGERS, slotClassOf, triggerLabel, type SpellId } from "../data/spells";
import { stepInterval } from "./casting";
import type { SpellEntry } from "./loadout";
import type { World } from "./world";

/**
 * What the build strip is allowed to say, derived rather than drawn. Keeping it out of the
 * renderer is what lets the numbers on screen be tested against the numbers that fire.
 */

/** A step-counted spell's clock: `taken` steps of `interval` are in. */
export interface Charge {
  taken: number;
  interval: number;
}

export interface SpellSlot {
  id: SpellId;
  glyph: string;
  level: number;
  /** What arms this slot, in words. */
  trigger: string;
  /**
   * Null for everything without a clock. A readiness light on something permanently ready
   * only trains the eye to check a field that never changes, so nothing goes there.
   */
  charge: Charge | null;
  /**
   * How far a weapon reaches, and null for a spell. A weapon fires every turn, so it has
   * no clock to show and its range is the thing worth knowing in that space instead.
   */
  reach: number | null;
  /**
   * What a weapon puts out per turn, and null for a spell.
   *
   * DESIGN.md says a weapon slot shows "its range and nothing else". Playtesting said
   * otherwise: with two slots both reading `every turn`, nothing on screen distinguished
   * a Dagger from a Maul or showed an upgrade landing. Logged as a deliberate departure
   * in BALANCE.md. Spells keep their prose — their levels change shape, not just numbers.
   */
  power: { damage: number; targets: number } | null;
}

/** Passives have no trigger and no clock, so this carries neither. */
export interface PassiveSlot {
  id: PassiveId;
  glyph: string;
  level: number;
}

export function readSpellSlots(world: World): SpellSlot[] {
  return world.loadout.spells.map((entry) => readSlot(world, entry));
}

/** Weapons read exactly like spells do; only what sits in the right-hand column differs. */
export function readWeaponSlots(world: World): SpellSlot[] {
  return world.loadout.weapons.map((entry) => readSlot(world, entry));
}

function readSlot(world: World, entry: SpellEntry): SpellSlot {
  const definition = SPELLS[entry.id];
  const interval = intervalOf(world, entry);
  const isWeapon = slotClassOf(entry.id) === "weapon";
  const level = world.loadout.levelOf(entry);
  return {
    id: entry.id,
    glyph: definition.glyph,
    level: entry.level,
    trigger: triggerLabel(definition.trigger, interval ?? undefined),
    charge: chargeOf(entry, interval),
    reach: isWeapon ? (definition.range ?? 1) : null,
    // Run through the modifiers the caster uses, so the number on screen is the number
    // that lands rather than the authored one.
    power: isWeapon
      ? {
          damage: world.modifiers.damageFor(definition.school, level.damage),
          targets: level.count ?? 1,
        }
      : null,
  };
}

/**
 * The step interval actually in force — the level's own override run through Tome's
 * reduction — or null for a trigger with no clock at all. It is derived the same way the
 * caster derives it, so what the strip promises and what fires cannot drift apart.
 */
function intervalOf(world: World, entry: SpellEntry): number | null {
  const definition = SPELLS[entry.id];
  if (!TRIGGERS[definition.trigger].counted) return null;
  return world.modifiers.intervalFor(stepInterval(definition, world.loadout.levelOf(entry)));
}

function chargeOf(entry: SpellEntry, interval: number | null): Charge | null {
  // Tome can drive an interval to 1, and a spell that fires on every step is as
  // permanently ready as a reactive one — a charge there is the same noise.
  if (interval === null || interval <= 1) return null;
  // Taking Tome mid-run can leave more steps banked than the new interval wants. The
  // fraction is clamped rather than left to read `4/3`; either way the next step fires it.
  return { taken: Math.min(entry.steps, interval), interval };
}

export function readPassiveSlots(world: World): PassiveSlot[] {
  return world.loadout.passives.map((entry) => ({
    id: entry.id,
    glyph: PASSIVES[entry.id].glyph,
    level: entry.level,
  }));
}
