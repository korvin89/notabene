import type { Point } from "../core/grid";
import type { PassiveId } from "../data/passives";
import type { SpellId } from "../data/spells";
import type { Actor } from "./actor";

export type RunOutcome = "win" | "loss" | null;

/** The results screen's whole input. Win and loss show the same thing. */
export interface RunSummary {
  outcome: RunOutcome;
  turns: number;
  kills: number;
  level: number;
  seed: string;
  /** The weapon the run opened with, so seed plus weapon replays it exactly. */
  weapons: { id: SpellId; level: number }[];
  spells: { id: SpellId; level: number }[];
  passives: { id: PassiveId; level: number }[];
}

/**
 * Everything the model does that the screen might want to show. The model never waits on
 * these — it resolves the whole turn, emits, and moves on; the visual layer replays them
 * at its own pace.
 */
export type WorldEvent =
  | { type: "move"; actor: Actor; from: Point; to: Point }
  | { type: "attack"; actor: Actor; target: Actor }
  | { type: "damage"; actor: Actor; amount: number; at: Point }
  | { type: "death"; actor: Actor; at: Point }
  | { type: "turn"; actor: Actor }
  | { type: "blink"; actor: Actor; from: Point; to: Point }
  | { type: "gem"; at: Point; value: number }
  | { type: "chest"; at: Point }
  | { type: "run-over"; outcome: Exclude<RunOutcome, null>; turns: number }
  | { type: "evolution"; from: SpellId; into: SpellId; at: Point }
  | {
      type: "spell";
      spell: SpellId;
      origin: Point;
      /** Tiles the effect visibly covers — a bolt line, a burst footprint, a chain. */
      path: Point[];
      /** How deep into a cascade this cast was, so the replay can stagger it. */
      depth: number;
    };

export interface CascadeEntry {
  turn: number;
  trigger: string;
  depth: number;
  subject?: string;
}

export type WorldListener = (event: WorldEvent) => void;
